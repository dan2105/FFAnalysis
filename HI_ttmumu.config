% ----------- %
% - SAMPLES - %
% ----------- %

Sample: "data"
	FillColor: 3
	HistoFile: data
	LineColor: 3
	Title: data
	Type: DATA

Sample: "ttHijing"
	FillColor: 4
	HistoFile: ttHijing
	LineColor: 4
	Title: ttHijing
	Type: BACKGROUND

Sample: "zmumu"
	FillColor: 5
	HistoFile: zmumu
	LineColor: 5
	Title: zmumu
	Type: BACKGROUND

% ----------------- %
% - NORM. FACTORS - %
% ----------------- %

NormFactor: "mu_signal"
	Max: 100
	Min: -100
	Nominal: 1
	Samples: ttHijing
	Title: ""#mu(signal)""

% --------------- %
% - SYSTEMATICS - %
% --------------- %

