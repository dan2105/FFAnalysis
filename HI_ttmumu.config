% ------- %
% - JOB - %
% ------- %

Job: "my_fit"
	HistoChecks: NOCRASH
	HistoPath: ../output_histograms/
	ImageFormat: pdf
	Lumi: 1
	POI: mu_signal
	ReadFrom: HIST

% ------- %
% - FIT - %
% ------- %

Fit: "fit"
	FitBlind: True
	FitRegion: CRSR
	FitType: SPLUSB
	POIAsimov: 1

% ----------- %
% - REGIONS - %
% ----------- %

